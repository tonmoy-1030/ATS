	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="476"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="524"/>
	<queryString>
		<![CDATA[SELECT ROW_NUMBER() OVER (
                          ORDER BY jobs_businessunit.short_name DESC) AS SL,
                         jobs_businessunit.short_name AS Unit,
                         COUNT(e.id) AS "No of Emp"
FROM employees_employee e
JOIN jobs_businessunit ON e.unit_id = jobs_businessunit.id
WHERE MONTH(e.DOJ) = MONTH(CURDATE())
  AND YEAR(e.DOJ) = YEAR(CURDATE())
GROUP BY jobs_businessunit.short_name;]]>
	</queryString>
	<field name="SL" class="java.math.BigInteger">
		<property name="com.jaspersoft.studio.field.label" value="SL"/>
	</field>
	<field name="Unit" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="Unit"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="jobs_businessunit"/>
	</field>
	<field name="No of Emp" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="No of Emp"/>
	</field>
